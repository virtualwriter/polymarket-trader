# Copy this file to config.env on each machine and fill in real values locally.
# Do not commit config.env, .env, private keys, API tokens, cookies, or SMTP passwords.

# Wallet Configuration
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Network Configuration
RPC_URL=https://polygon-bor-rpc.publicnode.com
CLOB_API_URL=https://clob.polymarket.com
CLOB_URL=https://clob.polymarket.com

# Multi-RPC failover for on-chain reads (pUSD balance/allowance, CTF balances).
# Comma/space/newline-separated list, tried in order, then a built-in public
# pool. Used by scripts/lib/polygon-rpc.ts (hourly executor + arb daemon).
# Also honored: POLYGON_RPC_URL, INFURA_POLYGON_API_KEY, ALCHEMY_POLYGON_API_KEY.
POLYGON_RPC_URLS=https://polygon.drpc.org,https://polygon.publicnode.com,https://1rpc.io/matic

# Optional network/proxy controls for live Polymarket access
SOCKS_PROXY=
ALL_PROXY=

# Market-maker configuration
CONDITION_ID=0xYOUR_CONDITION_ID
STRATEGY=amm
CONFIG=./config/amm_medium_volatility_adaptive.json

# Production runtime state. The VPS wrappers set this to /var/lib/polymarket-trader.
# For local development, leave unset to use .runtime/ inside the repo.
POLYMARKET_TRADER_STATE_DIR=
POLYMARKET_TRADER_LIVE_PORTFOLIO=
POLYMARKET_TRADER_PENDING_CLOSED_TRADES=

# Trading-engine inputs
INSTRUMENT_SNAPSHOT_LOOKBACK=12
OIL_CRUDE_HISTORY_START=2026-04-28

# Live monotonic-arb scanner (report/shadow only; no order execution)
MONOTONIC_ARB_LIVE_EVENT_SLUGS=
MONOTONIC_ARB_LIVE_MIN_EDGE=0.001
MONOTONIC_ARB_LIVE_MIN_LIQUIDITY=10000
MONOTONIC_ARB_LIVE_MAX_SPREAD=0.01
MONOTONIC_ARB_LIVE_MIN_SIZE=10

# Real Polymarket monotonic-arb executor.
# Keep hard-disabled/dry-run until the relayer transaction builder is reviewed.
ENABLE_MONOTONIC_ARB_REAL_PM=0
DISABLE_REAL_PM_TRADING=1
MONOTONIC_ARB_REAL_PM_DRY_RUN=1
MONOTONIC_ARB_REAL_PM_BUILD_ONLY=0
MONOTONIC_ARB_REAL_PM_SOURCE=scan
MONOTONIC_ARB_REAL_PM_PACKAGE_ID=
MONOTONIC_ARB_REAL_PM_MAX_PACKAGE_USD=1
# Polymarket enforces a per-market minimum order size (default 5 shares, read
# live from GET /book). Each leg must clear it, so a 5-share arb at ~$1/share
# costs ~$5. The bot auto-expands the per-package budget up to this ceiling to
# satisfy that minimum (bounded so spend stays capped). NOTE: a single 5-share
# arb (~$5) will nearly exhaust MAX_DAILY_USD=5 below; raise the daily cap if you
# want more than ~one arb/day.
MONOTONIC_ARB_REAL_PM_MAX_PACKAGE_USD_CEILING=6
MONOTONIC_ARB_REAL_PM_MAX_DAILY_USD=5
MONOTONIC_ARB_REAL_PM_MAX_PER_RUN=1
MONOTONIC_ARB_REAL_PM_MAX_OPEN_PACKAGES=20
MONOTONIC_ARB_REAL_PM_MIN_EDGE=0.001
MONOTONIC_ARB_REAL_PM_MIN_LIQUIDITY=10000
MONOTONIC_ARB_REAL_PM_MAX_SPREAD=0.01
MONOTONIC_ARB_REAL_PM_MIN_AVAILABLE_SHARES=10
MONOTONIC_ARB_REAL_PM_MIN_ORDER_SHARES=1
# CLOB rejects marketable BUY orders below $1 notional. The real arb executor
# submits two separate FAK BUY legs, so each leg must independently clear this.
MONOTONIC_ARB_REAL_PM_MIN_MARKETABLE_BUY_USD=1
MONOTONIC_ARB_REAL_PM_ASSETS=BTC,ETH,GOLD,SOL,SILVER,SPY,NBA

# Always-on websocket arb daemon (scripts/polymarket-arb-daemon.ts, Japan host).
# Reuses the gates/caps above; these only tune the event loop. The daemon is the
# SINGLE real-PM executor when running — disable polymarket-real-executor.timer.
# Values below mirror the live Japan host /etc/polymarket-pm-executor.env so the
# template stays a faithful runbook; keep them in sync when you change the box.
ARB_DAEMON_MAX_PER_MIN=3
ARB_DAEMON_WATCHLIST_REFRESH_MS=300000
ARB_DAEMON_BALANCE_REFRESH_MS=300000
ARB_DAEMON_LEDGER_FLUSH_MS=120000
ARB_DAEMON_FILL_WAIT_MS=3000
ARB_DAEMON_PING_MS=10000
# Auto-discover same-day MLB game ladders into the watchlist.
ARB_DAEMON_DISCOVER_MLB_GAMES=1
# Global pause trips only if a single naked leg exceeds this many shares; smaller
# sports residuals are scoped to a per-event pause instead (see below).
ARB_DAEMON_MAX_NAKED_SHARES_BEFORE_PAUSE=25
# Balance headroom held back from every execution (concurrent fills + fee dust).
ARB_DAEMON_BALANCE_HEADROOM_USD=0.5
# Log near-miss telemetry every N ms so operators can see whether arbs are
# barely missing or genuinely absent. Reports bucket counts for cost<=1.005,
# <=1.002, <=1.001, breakeven, and executable levels, plus top near-misses.
ARB_DAEMON_NEAR_MISS_LOG_MS=60000
ARB_DAEMON_NEAR_MISS_TOP_N=5
# Durable conversion audit. Real execution candidates write full lifecycle rows;
# non-executable true-middle candidates in this cost window write shadow rows so
# we can study 1.000-1.005, 1.005-1.02, and 1.02-1.05 blockers without submitting.
ARB_DAEMON_CAPTURE_AUDIT_MIN_COST=0.95
ARB_DAEMON_CAPTURE_AUDIT_MAX_COST=1.05
ARB_DAEMON_CAPTURE_AUDIT_MIN_INTERVAL_MS=5000
# Live sports books still get a fresh preflight, but clean arbs should size to
# max paired visible depth rather than fail a sports-only share floor.
# SPORTS_MIN_EDGE=0.01 requires >=1c of locked edge (pair cost <= 0.99) before we
# enter, so a small adverse tick during the ~290ms preflight lands at break-even
# instead of negative. Raising it filters fragile near-zero-edge entries.
ARB_DAEMON_SPORTS_MIN_EDGE=0.01
ARB_DAEMON_SPORTS_MIN_AVAILABLE_SHARES=5
ARB_DAEMON_SPORTS_MAX_SPREAD=0.04
ARB_DAEMON_SPORTS_MAX_PAIRED_SHARES=0
ARB_DAEMON_SPORTS_DEPTH_RESERVE_MULTIPLIER=2
ARB_DAEMON_SPORTS_PRICE_SLIPPAGE=0
# 0 = no start-time cutoff; sports ladders stay executable up to event end.
ARB_DAEMON_SPORTS_ENTRY_CUTOFF_MS=0
# Sports residual at/under this many shares is treated as dust on exit.
ARB_DAEMON_SPORTS_ORPHAN_DUST_SHARES=25
# Extra balance headroom for sports legs (USD + multiplier on notional).
ARB_DAEMON_SPORTS_BALANCE_HEADROOM_USD=0.5
ARB_DAEMON_SPORTS_BALANCE_HEADROOM_MULTIPLIER=1.03
# Hedge completion pricing — structural fix for the ~290ms preflight reprice.
# After the cheap leg fills, price the hedge FAK at the locked-pair break-even
# ceiling (1 - cheapAvgFill) instead of the stale snapshot ask: a hedge that
# ticked up still completes the pair as long as the pair stays profitable, and
# only a reprice past break-even no-fills (a clean cheap-leg orphan we unwind).
# Risk-free because the monotonic-middle floor always pays >= $1. Set to 0 to
# revert to snapshot-ask hedge pricing.
ARB_DAEMON_SPORTS_HEDGE_BREAKEVEN_FILL=1
# Price edge the completed pair must retain vs $1.00. 0 = complete at break-even.
# Raise to demand realized edge on completion (more orphans when hedges reprice).
ARB_DAEMON_SPORTS_HEDGE_COMPLETION_MIN_EDGE=0
# Non-sports only: when displayed profitable touch is below the exchange-min
# share count but above the normal min-touch gate, send an exchange-min FAK and
# let it partially fill the visible arb.
ARB_DAEMON_NON_SPORTS_EXCHANGE_MIN_BUFFER_SHARES=25
# Submitted rows with zero fill/cost older than this do not count against the
# daemon's open package cap. This prevents interrupted no-fill attempts from
# blocking future arbs.
ARB_DAEMON_STALE_SUBMITTED_MS=600000
# Keep completed sports test packages in the live ledger long enough for Gamma
# to publish final outcomes; rows are archived after this grace window.
ARB_DAEMON_NBA_LEDGER_ARCHIVE_GRACE_MS=86400000
# Set to 1 to have the daemon git-commit/push the ledger on a timer (off the hot
# path). Off by default; leave the hourly US trader / cron to push if preferred.
ARB_DAEMON_GIT_PUSH=0
# Set to 1 to git pull + npm ci once when the daemon (re)starts.
ARB_DAEMON_PULL_ON_START=0

# ── Orphan completion / unwind (naked-leg handling) ──
# When parallel taker fills leave one leg naked, the daemon does NOT hold it to a
# directional resolution. It re-pairs the naked leg across the SAME event's live
# ladder into a positive-EV monotonic package, and falls back to flattening
# (FAK-sell) if it can't. Tracked in data/polymarket-live-orphans.json.
# Cadence of the completion/unwind sweep (ms).
ARB_DAEMON_ORPHAN_POLL_MS=1000
# Tight price stop: unwind the instant the orphan's best bid is this many cents
# below our fill. This is the dominant guard — bounds directional bleed hard,
# which is what makes the long (until-expiry) completion hunt safe.
ARB_DAEMON_ORPHAN_STOP_CENTS=0.01
# Completion counts as positive-EV only if fillPrice + complementAsk < 1 by at
# least this margin (survives slippage).
ARB_DAEMON_ORPHAN_COMPLETION_MARGIN=0.01
# Non-sports orphan completion can take any positive lock. NBA/live sports keep
# ARB_DAEMON_ORPHAN_COMPLETION_MARGIN.
ARB_DAEMON_NON_SPORTS_ORPHAN_COMPLETION_MARGIN=0
# Force-unwind this long before the orphan market's own expiry so we never roll
# into a directional settlement (ms; default 10 min).
ARB_DAEMON_ORPHAN_EXPIRY_BUFFER_MS=600000
# Throttle the live event ladder re-fetch per orphan (ms).
ARB_DAEMON_ORPHAN_LADDER_REFRESH_MS=5000
# Residual orphan below this many shares is treated as dust and flattened.
ARB_DAEMON_ORPHAN_MIN_SHARES=1
# Dust exits top up with a short-lived limit order only when the combined
# position can immediately be sold at no loss or better.
ARB_DAEMON_DUST_EXIT_LIMIT_WAIT_MS=5000
ARB_DAEMON_DUST_EXIT_RETRY_MS=60000
ARB_DAEMON_DUST_EXIT_MIN_MARKETABLE_BUY_USD=1
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
POLYMARKET_RELAYER_TX_TYPE=PROXY
POLYMARKET_PROXY_WALLET_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=1
POLYMARKET_FUNDER_ADDRESS=
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
POLY_BUILDER_CODE=
POLY_BUILDER_API_KEY=
POLY_BUILDER_PASSPHRASE=
POLY_BUILDER_SECRET=

# LLM hypothesis generation (optional)
# LLM_PROVIDER controls the API backend: "anthropic" (default) or "deepseek".
# When "deepseek" is set, ANTHROPIC_API_KEY is used as the Bearer token for
# api.deepseek.com, and ANTHROPIC_MODEL selects the DeepSeek model name
# (e.g. deepseek-v4-flash, deepseek-v4-pro).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# LLM cadence: minimum hours between scheduled calls (default 2).
# LLM_MAX_CALLS_PER_DAY: hard cap on LLM calls per UTC day (default 12).
# LLM_NEW_SIGNAL_DEDUPE_HOURS: suppress LLM if same signal types repeat within this window (default 6).
# LLM_REQUEST_TIMEOUT_MS: API timeout in ms (default 300000 / 5 min).
# Optional model/token cap for explicit Telegram /ask and /review commands.
# Defaults to ANTHROPIC_MODEL and 900 tokens.
TELEGRAM_LLM_MODEL=
TELEGRAM_LLM_MAX_TOKENS=900

# CME Options Analytics API (optional)
# Set either CME_API_BEARER_TOKEN directly or client credentials for OAuth.
CME_API_BEARER_TOKEN=
CME_API_CLIENT_ID=
CME_API_CLIENT_SECRET=
CME_API_SCOPE=
CME_GREEKS_API_BASE=https://markets.api.cmegroup.com/greeks/v1
CME_TOKEN_URL=https://auth.cmegroup.com/as/token.oauth2
CME_OPTIONS_QUERY_PARAM=undlyProductCodes
CME_BTC_UNDLY_PRODUCT_CODE=BTC
CME_GOLD_UNDLY_PRODUCT_CODE=GC
CME_OIL_UNDLY_PRODUCT_CODE=CL

# TradingView subscribed options-chain fallback (optional)
# Requires a logged-in TradingView session cookie with access to the futures options chains.
TRADINGVIEW_OPTIONS_ENABLED=0
TRADINGVIEW_COOKIE=
TRADINGVIEW_OPTIONS_MAX_ROWS=10000
TRADINGVIEW_OPTIONS_MAX_UNDERLYINGS=12
TRADINGVIEW_TIMEOUT_SECONDS=20
TRADINGVIEW_OPTIONS_COLLECTOR_TIMEOUT_MS=120000
OPTIONS_COLLECTOR_MAX_BUFFER_BYTES=52428800
# Optional JSON override. Defaults:
# {"CME_CL":{"tv_symbol":"NYMEX:CL1!"},"CME_GC":{"tv_symbol":"COMEX:GC1!"},"CME_BTC":{"tv_symbol":"CME:BTC1!"},"CME_ES":{"tv_symbol":"CME_MINI:ES1!"}}
TRADINGVIEW_OPTIONS_ASSETS=

# Daily paper-trader report delivery (optional)
# Reports are always written to data/daily-email-reports; outbound delivery sends only when credentials are set.
DAILY_REPORT_TZ=America/New_York

# Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional comma-separated allowlist for the interactive trader bot.
# Defaults to TELEGRAM_CHAT_ID when unset.
TELEGRAM_ALLOWED_CHAT_IDS=

# Email delivery
DAILY_REPORT_EMAIL_TO=
DAILY_REPORT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional sports/simulation integrations
SIM_SERVER_URL=http://localhost:8080
PORT=8080
FEE_RATE=0.0175
MM_MAX_FILL_USDC=500000000
MM_SKEW_UNIT_USDC=500000000
SPORTRADAR_API_KEY=
BETFAIR_API_KEY=
ODDS_API_KEY=
