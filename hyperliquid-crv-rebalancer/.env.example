# Hyperliquid API Authentication
#
# OPTION A: Raw private key (recommended for headless/server setups)
# HYPERLIQUID_PRIVATE_KEY=0x...
#
# OPTION B: BIP-39 mnemonic phrase (12 or 24 words)
# HYPERLIQUID_MNEMONIC="word1 word2 word3 ... word12"
#
# Network
# HYPERLIQUID_MAINNET=true   # true = mainnet, false = testnet
